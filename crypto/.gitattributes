# .gitattributes - Normalize line endings across platforms

* text=auto

# Source code
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.csv binary
*.xlsx binary
*.pbix binary

# Documentation
*.md text diff=markdown
LICENSE text eol=lf

# Lockfiles
package-lock.json text eol=lf
poetry.lock text eol=lf
