{"version":120,"schema_version":1,"doc":{"type":"doc","attrs":{"table_of_contents":{"enabled":false,"allowedLevels":[1,2,3]}},"content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"#############################################"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Additional Documentation:  "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://ibm.ent.box.com/v/AML-Anti-Money-Laundering-Data/file/780515045707"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"PDF Deck"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"#############################################"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"em"},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Feb 28, 2023 Update:"},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"  New and improved data available "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://kaggle.com/ealtman2019/ibm-transactions-for-anti-money-laundering-aml"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"here"}]},{"type":"horizontal_rule"},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"AML"},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":" = "},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"underline"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"A"},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"nti "},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"underline"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"M"},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"oney "},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"underline"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"L"},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"aundering"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"This AML data is in CSV format and represents financial transactions -- bank transfers, purchases, credit card transactions, checks, etc. Most of the transactions are legitimate. A few represent money laundering. A "},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"em"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"laundering"},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":" tag is provided with each transaction. With that "},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"em"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"laundering"},{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":" tag, AML models can use this data for training and to test their inferences."}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"The data is generated using a multi-agent virtual world model. All of the agents in the virtual world have actions governed by statistical distributions. Thus the model and data are NOT based on obfuscating or anonymizing real individuals. Everything is synthetic. More specifically the underlying model uses a virtual world of banks, individuals, and companies -- with individuals and companies buying items, and doing bank transfers to make payments, get supplies, pay salaries, etc. The underlying model has good and bad actors, with bad actors doing things like smuggling, extortion, illegal gambling, etc. The bad actors sometimes attempt to launder ill-gotten funds resulting in money-laundering transactions."}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Data Characteristics"}]},{"type":"paragraph"},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"3000 Individuals"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Transactions span 1 month:  January 2019"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"trans_3000p2_list.txt "},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"file lists all 45,351,509 transactions"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Transactions are among entities (individuals, corporations, partnerships, etc) via their bank accounts"}]}]}]},{"type":"paragraph"},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"RELATED WORK"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Alternate AML Data and Models: "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://github.com/IBM/AMLSim"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"https://github.com/IBM/AMLSim"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Focus on models"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Data generation does not use detailed virtual world approach used here"}]}]}]}]},{"type":"paragraph"},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Synthetic credit card transaction data: "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://github.com/IBM/TabFormer"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"https://github.com/IBM/TabFormer"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Labeled for fraud / not-fraud"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_color","attrs":{"color":"#24292e"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"Github site contains both data and Transformer-based fraud detection model"}]}]}]}]},{"type":"paragraph"},{"type":"paragraph"}]},"savepoint_metadata":{"savepointFileId":"780521733815","savepointsInfo":{"5":{"timestamp":1614281971844,"type":"session","authorsSinceLastSavepoint":["248126054"]},"7":{"timestamp":1614292707811,"type":"session","authorsSinceLastSavepoint":["248126054"]},"20":{"timestamp":1614342984274,"type":"session","authorsSinceLastSavepoint":["248126054"]}},"shouldCreateSavepointBeforeApplyingNextVersion":false,"authorsSinceLastSavepoint":{"248126054":true},"allAuthorNames":{"2":"Anonymous User","248126054":"Erik Altman"}},"last_edit_timestamp":1677594030675}