{"version":522,"schema_version":1,"doc":{"type":"doc","attrs":{"table_of_contents":{"enabled":true,"allowedLevels":[1,2,3]}},"content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"February 28, 2023:"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"A new, more robust set of data has been released:"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"link","attrs":{"href":"https://kaggle.com/ealtman2019/ibm-transactions-for-anti-money-laundering-aml"}},{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"https://kaggle.com/ealtman2019/ibm-transactions-for-anti-money-laundering-aml"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"This new data has 6 individual datasets:"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"LI"},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":":  Lower Illicit Ratio (Less Laundering)"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"HI"},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":":  Higher Illicit Ratio (More Laundering)"}]}]}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"For both "},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"LI"},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":" and "},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"strong"},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":"HI"},{"type":"text","marks":[{"type":"font_size","attrs":{"size":"1.25em"}},{"type":"author_id","attrs":{"authorId":"248126054"}}],"text":", there are small, medium, and large datasets with approximately 5 million, 30 million, and 180 million transactions."}]},{"type":"paragraph"}]},"savepoint_metadata":{"savepointFileId":null,"savepointsInfo":{"470":{"timestamp":1677593878642,"type":"session","authorsSinceLastSavepoint":["248126054"]}},"shouldCreateSavepointBeforeApplyingNextVersion":false,"authorsSinceLastSavepoint":{"248126054":true},"allAuthorNames":{"248126054":"Erik Altman"}},"last_edit_timestamp":1677594263192}